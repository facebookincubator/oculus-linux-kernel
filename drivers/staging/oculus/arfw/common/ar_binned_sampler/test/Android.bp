cc_test {
    name: "libarfw_ar_binned_sampler_tests",
    native_coverage: true,
    defaults: [
        "libarfw_internal_common_defaults",
        "oculus_gtest_defaults",
    ],
    srcs: [
        "ArBinnedSamplerTest.cpp",
    ],
