CONFIG_META_OATMEAL=y

# AR PCI support
CONFIG_ARFIRMWARE=y
CONFIG_ARFIRMWARE_COMMON=m
CONFIG_ARFIRMWARE_AVO_PCI=m
CONFIG_ARFIRMWARE_AVO_PCI_MSM_PCIE=y
CONFIG_ARFIRMWARE_TEST=m
CONFIG_ARFIRMWARE_TEST_CLIENT=m

# BoB regulator
CONFIG_REGULATOR_MP28167=y

# Graphics modules
CONFIG_SXR_DISPCC_NEO=m
CONFIG_SXR_GPUCC_NEO=m
CONFIG_QTI_DEVFREQ_CDEV=m

# LED modules
CONFIG_LEDS_AW2016=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_LP55XX_COMMON=y
CONFIG_LEDS_LP5562=y

# Peripheral control
CONFIG_ACROPOLIS_CTRL=y
CONFIG_DAM_CTRL=y

# GPIO decoder for the switch
CONFIG_INPUT_GPIO_DECODER_IRQ=y

# SWD for flashing MCUs
CONFIG_OCULUS_MCU=y
CONFIG_OCULUS_SWD=y
CONFIG_OCULUS_SWD_STM32L4=y

# USB PD and CC detection
CONFIG_STUSB4500_USB=y

# Wi-Fi bdata file override
CONFIG_CNSS_META_BOARD_ID_OVERRIDE=y

# Brow temperature sensors
CONFIG_MAX31875_I2C=y
