# ADC modules
CONFIG_INA2XX_ADC=y
CONFIG_TI_ADS1015=y

# AR PCI support
CONFIG_ARFIRMWARE=y
CONFIG_ARFIRMWARE_COMMON=m
CONFIG_ARFIRMWARE_ACRO_PCI=m
CONFIG_ARFIRMWARE_ACRO_UART=m
CONFIG_ARFIRMWARE_ACRO_UART_TEST=m
CONFIG_ARFIRMWARE_TEST=m

# Use legacy MSM GPIO init
CONFIG_PCI_MSM_GPIO_INIT_LEGACY=y

# Graphics modules
CONFIG_DRM_MSM=m
CONFIG_SXR_DISPCC_NEO=m
CONFIG_SXR_GPUCC_NEO=m
CONFIG_QTI_DEVFREQ_CDEV=m

# LED modules
CONFIG_LEDS_AW2016=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_LP55XX_COMMON=y
CONFIG_LEDS_LP5562=y

# Max17332
CONFIG_MAX17332_CURRENT_OVERRIDE=y
CONFIG_MAX17332_VOLTAGE_ADJUSTMENT=y
CONFIG_MAX17332_CDEV=y

# Max77789
CONFIG_MAX77789=y

# Peripheral control
CONFIG_ACROPOLIS_CTRL=m
CONFIG_DAM_CTRL=y

# SWD for flashing MCUs
CONFIG_OCULUS_MCU=y
CONFIG_OCULUS_SWD=y
CONFIG_OCULUS_SWD_STM32L4=y

# Brow temperature sensors
CONFIG_MAX31875_I2C=y

# PM8150 XO Clock
CONFIG_PM8150_XO=y

# HL7594 BUCK, which powers WCN7851 chip
CONFIG_REGULATOR_HL7594=y

# Virtual driver for USB thermal reading
CONFIG_IIO_CHANNEL_TEMP_SENSOR=y

# Enable WLAN robust recovery
CONFIG_CNSS_META_ROBUST_RECOVERY=y

# Enable WLAN channel disable via wlan.cfg
CONFIG_WLAN_META_CHAN_DISABLE=y
