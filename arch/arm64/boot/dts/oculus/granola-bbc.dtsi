&pcal6408 {
	status = "disabled";
};

&tps61280 {
	status = "disabled";
};

&bbc_ctrl {
	status = "disabled";
};

&qupv3_se10_i2c {
	tca9536: tca9536@43 {
		compatible = "ti,tca9536";
		reg = <0x43>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "fem_fpwm_sel", "power_switch_en", "bat_boost_en", "reserve";
		/* Configure SEL_FEM_FPWM-Pin0 as output */
		enable-output = <0x01>;
		/* Initialize SEL_FEM_FPWM to low state for TPS62802 work as FPWM */
		initial-state = <0x00>;
		status = "okay";
	};

	boost_granola: boost_granola@75 {
		compatible = "meta,boost_granola";
		reg = <0x75>;
		boost-en-gpios = <&tca9536 2 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		status = "okay";
	};
};

&soc {
	bbc_ctrl_granola: bbc_ctrl_granola {
		compatible = "meta,bbc-ctrl-granola";
		boost-supply = <&boost_granola>;
		boost-voutroof-th-uv = <3500000>;
		extcon = <&max77789>;
		status = "okay";
	};
};
