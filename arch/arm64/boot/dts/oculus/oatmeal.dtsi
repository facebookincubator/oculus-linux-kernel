#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "meta-neo-common.dtsi"

&qupv3_se10_i2c {
	/**
	 * This needs to come after the BOB nodes because I2C probe order is
	 * determined by the order of the device tree nodes and max77132 needs to
	 * request the BOB regulator during probe.
	 */
	#include "meta-neo-max17332-fg.dtsi"
};

&tlmm {
	gpio_power_btn: gpio_power_btn {
		mux {
			pins = "gpio39";
			function = "gpio";
		};

		config {
			pins = "gpio39";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};

	gpio_action_btn: gpio_action_btn {
		mux {
			pins = "gpio76";
			function = "gpio";
		};

		config {
			pins = "gpio76";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};

	gpio_vol_down: gpio_vol_down {
		mux {
			pins = "gpio101";
			function = "gpio";
		};

		config {
			pins = "gpio101";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};

	clk_generator_acro: clk_generator_acro {
		mux {
			pins = "gpio73";
			function = "gpio";
		};

		config {
			pins = "gpio73";
			drive-strength = <8>;
			bias-disable;
		};
	};

	clk_generator_mcu: clk_generator_mcu {
		mux {
			pins = "gpio74";
			function = "gpio";
		};

		config {
			pins = "gpio74";
			drive-strength = <8>;
			bias-disable;
		};
	};

	acro_enable_pin: acro_enable_pin {
		mux {
			pins = "gpio105";
			function = "gpio";
		};

		config {
			pins = "gpio105";
			drive-strength = <8>;
			bias-disable;
			output-low;
		};
	};

	acro_reset_pin: acro_reset_pin {
		mux {
			pins = "gpio32";
			function = "gpio";
		};

		config {
			pins = "gpio32";
			drive-strength = <8>;
			bias-disable;
			input-enable;
		};
	};

	acro_soc_alive_pin: acro_soc_alive_pin {
		mux {
			pins = "gpio67";
			function = "gpio";
		};

		config {
			pins = "gpio67";
			bias-disable;
			input-enable;
		};
	};

	dam_float_swd: dam_float_swd {
		mux {
			pins = "gpio152", "gpio153";
			function = "gpio";
		};

		config {
			pins = "gpio152", "gpio153";
			drive-strength = <6>;
			bias-disable;
			input-enable;
		};
	};

	dam_reset_pin: dam_reset_pin {
		mux {
			pins = "gpio151";
			function = "gpio";
		};

		config {
			pins = "gpio151";
			drive-strength = <8>;
			bias-disable;
			output-low;
		};
	};

	soc_acro_alive_on: soc_acro_alive_on {
		mux {
			pins = "gpio68";
			function = "gpio";
		};

		config {
			pins = "gpio68";
			drive-strength = <8>;
			bias-disable;
			output-high;
		};
	};

	soc_mcu_alive_on: soc_mcu_alive_on {
		mux {
			pins = "gpio77";
			function = "gpio";
		};

		config {
			pins = "gpio77";
			drive-strength = <8>;
			bias-disable;
			output-high;
		};
	};

	soc_mcu_alive_off: soc_mcu_alive_off {
		mux {
			pins = "gpio77";
			function = "gpio";
		};

		config {
			pins = "gpio77";
			drive-strength = <2>;
			bias-pull-down;
			input-enable;
		};
	};

	cc_alert_defaults: cc_alert_defaults {
		mux {
			pins = "gpio118";
			function = "gpio";
		};

		config {
			pins = "gpio118";
			bias-pull-up;
			input-enable;
		};
	};

	cc_dts_default: cc_dts_default {
		mux {
			pins = "gpio40";
			function = "gpio";
		};

		config {
			pins = "gpio40";
			bias-pull-up;
			input-enable;
		};
	};

	bob_enable_pin: bob_enable_pin {
		mux {
			pins = "gpio52";
			function = "gpio";
		};

		config {
			pins = "gpio52";
			drive-strength = <8>;
			bias-disable;
			output-low;
		};
	};

	bob_alt_pin: bob_alt_pin {
		mux {
			pins = "gpio98";
			function = "gpio";
		};

		config {
			pins = "gpio98";
			bias-pull-up;
			input-enable;
		};
	};

	wcn_buck_vsel: wcn_buck_vsel {
		mux {
			pins = "gpio23";
			function = "gpio";
		};

		config {
			pins = "gpio23";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	};

	max77789_intb_pin: max77789_intb_pin {
		mux {
			pins = "gpio98";
			function = "gpio";
		};
		config {
			pins = "gpio98";
			bias-pull-up;
			input-enable;
		};
	};

	bypass_ta_mux_defaults: bypass_ta_mux_defaults {
		mux {
			pins = "gpio118";
			function = "gpio";
		};

		config {
			pins = "gpio118";
			bias-disable;
			output-low;
		};
	};

	rt600_nirq_off: rt600_nirq_off {
		mux {
			pins = "gpio132";
			function = "gpio";
		};

		config {
			pins = "gpio132";
			drive-strength = <2>;
			bias-pull-down;
			input-enabled;
		};
	};

	rt600_crash_notify_off: rt600_crash_notify_off {
		mux {
			pins = "gpio110";
			function = "gpio";
		};

		config {
			pins = "gpio110";
			drive-strength = <2>;
			bias-pull-down;
			input-enable;
		};
	};
};

&stp_mcu_request_transaction {
	config {
		/delete-property/ bias-pull-up;
		bias-disable;
	};
};

&soc {
	/* base definition in neo-pmic-overlay.dtsi */
	gpio_keys {
		pinctrl-0 = <&gpio_power_btn
				&gpio_action_btn
				&gpio_vol_up
				&gpio_vol_down>;

		power_btn {
			label = "power_button";
			gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			linux,code = <KEY_POWER>;
			wakeup-source;
			debounce-interval = <15>;
			linux,can-disable;
		};

		action_btn: action_btn {
			label = "action_button";
			gpios = <&tlmm 76 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			linux,code = <KEY_PLAYPAUSE>;
			wakeup-source;
			debounce-interval = <15>;
			linux,can-disable;
		};

		/* base definition in neo-pmic-overlay.dtsi */
		vol_up {
			label = "volume_up";
			wakeup-source;
		};

		vol_down {
			label = "volume_down";
			gpios = <&tlmm 101 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			linux,code = <KEY_VOLUMEDOWN>;
			wakeup-source;
			debounce-interval = <15>;
			linux,can-disable;
		};

		privacy_switch {
			label = "privacy_switch";
			gpios = <&tlmm 114 GPIO_ACTIVE_HIGH>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_MUTE_DEVICE>;
			wakeup-source;
			debounce-interval = <30>;
			linux,can-disable;
		};
	};

	qcom,cam-res-mgr {
		status = "disabled";
	};

	oculus,cam_fsync {
		status = "disabled";
	};

	camera_key {
		status = "disabled";
	};

	acropolis_ctrl: acropolis_ctrl {
		compatible = "meta,acropolis-ctrl";
		clocks = <&rpmhcc RPMH_RF_CLK2>;
		clock-names = "clk_gen_xin";
		pinctrl-names = "default";
		pinctrl-0 = <&acro_enable_pin &acro_reset_pin
			&soc_acro_alive_on &clk_generator_acro
			&acro_soc_alive_pin>;
		clk-en-gpios = <&tlmm 73 GPIO_ACTIVE_HIGH>;
		enable-gpios = <&tlmm 105 GPIO_ACTIVE_HIGH>;
		mute-gpios = <&tlmm 139 GPIO_ACTIVE_HIGH>;
		pwron-gpios = <&tlmm 54 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
		time-trigger-gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&tlmm>;
		interrupts = <67 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "acro-alive";
	};

	dam_swd {
		compatible = "oculus,swd";
		pinctrl-names = "default";
		pinctrl-0 = <&dam_float_swd>;
		oculus,swd-flavor = "stm32l47xxx";
		oculus,fw-path = "dam";
		oculus,swd-clk = <&tlmm 152 0>;
		oculus,swd-io = <&tlmm 153 0>;
		oculus,flash-block-size = <256>;
		oculus,flash-page-size = <2048>;
		oculus,flash-page-count = <256>;
		oculus,flash-page-retained-count = <1>;
		oculus,flash-page-bootloader-protected-count = <0>;
		oculus,flash-bank-count = <2>;
		oculus,manual-fw-loading;
		oculus,dam-reset-quirk;
		oculus,dam-ctrl = <&dam_ctrl>;
	};

	dam_ctrl: dam_ctrl {
		compatible = "meta,dam-ctrl";
		pinctrl-names = "default";
		pinctrl-0 = <&dam_reset_pin>;
		reset-gpios = <&tlmm 151 GPIO_ACTIVE_HIGH>;
		/* BOOT0 pin */
		rom-boot-gpios = <&tlmm 133 GPIO_ACTIVE_HIGH>;
		sbsfu-boot-gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
		keep-awake-gpios = <&tlmm 44 GPIO_ACTIVE_HIGH>;
	};

	wcn_ext_buck: wcn_ext_buck {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&wcn_buck_vsel>;
		regulator-name = "wcn_ext_buck";
		gpio = <&tlmm 13 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		/* Dummy config matching the BT/WLAN config */
		regulator-min-microvolt = <950000>;
		regulator-max-microvolt = <950000>;
	};

	bbc_ctrl: bbc_ctrl {
		compatible = "meta,bbc-ctrl";
		default-support-bbc-batt-ini = /bits/ 16 <0x35 0x36 0x38 0x39>;
		optional-support-bbc-batt-ini = /bits/ 16 <0x37>;
		/* Gpio for boost cricuit */
		boost-nbyp-gpio = <&pcal6408 2 GPIO_ACTIVE_HIGH>;
		nsw-en-gpio = <&pcal6408 3 GPIO_ACTIVE_HIGH>;
		vsys-ref-gpio = <&pcal6408 6 GPIO_ACTIVE_HIGH>;
		nshdn-en-gpio = <&pcal6408 7 GPIO_ACTIVE_HIGH>;
		io-channels = <&ads1115 6>;
		io-channel-names = "vsys";
		boost-voutroof-th-uv = <3750000>;
		/* Define rsoc and vbat boost threshold, rsoc for default */
		boost-th-rsoc = /bits/ 8 <15>;
		boost-th-battery-voltage-uv = <3600000>;
		vsys-convert-coeff = <1464545>;
		extcon = <&max77789>;
		status = "disabled";
	};

	iio_channel_temp_sensor: iio_channel_temp_sensor {
		compatible = "meta,iio-channel-temp-sensor";
		io-channels = <&ads1115 7>;
		io-channel-names = "vdd_3p3";
		/* For calculate NTC temp */
		pull-up-res = <100000>; /* ohm */
		voltage-ref = <3300>; /* mV */
		#thermal-sensor-cells = <0>;
		status = "disabled";
	};

	xo_temp_sensor: xo_temp_sensor {
		compatible = "meta,iio-channel-temp-sensor";
		io-channels = <&pm8150_vadc ADC5_XO_THERM_100K_PU>;
		io-channel-names = "pm8150_xo_therm";
		iio-temp;
		#thermal-sensor-cells = <0>;
		status = "ok";
	};
};

&rt600_nirq {
	mux {
		pins = "gpio132";
		function = "gpio";
	};

	config {
		pins = "gpio132";
		drive-strength = <2>;
		bias-pull-up;
		input-enabled;
	};
};

&rt600_crash_notify {
	mux {
		pins = "gpio110";
		function = "gpio";
	};

	config {
		pins = "gpio110";
		bias-pull-up;
		input-enabled;
	};
};

&rt600_boot2_high {
	mux {
		pins = "gpio22";
		function = "gpio";
	};

	config {
		pins = "gpio22";
		drive-strength = <8>;
		bias-disable;
		output-high;
	};
};

&rt600_boot2_low {
	mux {
		pins = "gpio22";
		function = "gpio";
	};

	config {
		pins = "gpio22";
		drive-strength = <8>;
		bias-disable;
		output-low;
	};
};

&rt600_ctrl {
	/delete-property/ rt600-spare-gpio2;
	meta,oatmeal-init-sequence;
	pinctrl-names = "default_rt600", "flashing_rt600", "shipmode";
	/* default */
	pinctrl-0 = <&rt600_boot0_low &rt600_boot2_low &rt600_nirq
		&rt600_crash_notify &soc_mcu_alive_on &clk_generator_mcu>;
	/* flashing */
	pinctrl-1 = <&rt600_boot0_high &rt600_boot2_high &rt600_nirq
		&rt600_crash_notify &soc_mcu_alive_on &clk_generator_mcu>;
	/* shipmode */
	pinctrl-2 = <&rt600_boot0_low &rt600_boot2_low &rt600_nirq_off
		&rt600_crash_notify_off &soc_mcu_alive_off &clk_generator_mcu>;
	clock-names = "clk_generator_xin";
	clocks = <&rpmhcc RPMH_RF_CLK2>;
	rstn-gpio = <&tlmm 33 0>;
	nirq-gpio = <&tlmm 132 0>;
	crash-notify-gpio = <&tlmm 110 0>;
	clk-en-gpio = <&tlmm 74 0>;
	mcu-en-gpio = <&tlmm 38 0>;
	mcu-alive-gpio = <&tlmm 41 0>;
	pca-on-gpio = <&tlmm 107 0>;
	soc-suspended-gpio = <&tlmm 146 0>;
};

&mfi343s00176 {
	status = "disabled";
};

&st60a3g1 {
	status = "disabled";
};

&rt6160 {
	status = "disabled";
};

&pcie1 {
	status = "ok";
	qcom,boot-option = <0x1>;

	qcom,no-l0s-supported;
	qcom,drv-l1ss-timeout-us = <10000>; /* 10ms */

	qcom,separate-refclk;

	/* Leave enough time for Acro's initial setup */
	qcom,perst-delay-us-min = <20000>;
	qcom,perst-delay-us-max = <20050>;

	/* Acro takes a bit of time to get ready */
	qcom,link-check-max-count = <40>; /* 200ms */

	// Override default QC config and use Separate Reference Clocks with
	// No SSC (SRNS). In this configuration, the refclk output is turned off
	qcom,phy-sequence = <0x0240 0x03 0x0
			0x00c0 0x00 0x0 // 0x00 - SSC off, 0x01 - SSC on
			0x00cc 0x31 0x0
			0x00d0 0x01 0x0
			0x0060 0xff 0x0
