&thermal_zones {
	wcn_temp_zone: wcn-temp {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&wcn_temp_sensor>;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	acro_temp_zone: acro-temp {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&acro_temp_sensor>;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};
};
