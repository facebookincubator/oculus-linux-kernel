/* This is not pretty design, but it does allow us to keep
 * the STP channels and priorities in sync with MCU.
 */
#include "../../../../../../../../vendor/meta/prebuilts/libs/device/neo-common/libs/libstp/include/stp/channels.h"

&tlmm {
	stp_mcu_request_transaction: stp_mcu_request_transaction {
		mux {
			pins = "gpio18";
			function = "gpio";
		};

		config {
			pins = "gpio18";
			drive-strength = <2>;
			bias-pull-up;
			input-enabled;
		};
	};

	stp_soc_has_data: stp_soc_has_data {
		mux {
			pins = "gpio19";
			function = "gpio";
		};

		config {
			pins = "gpio19";
			drive-strength = <2>;
			bias-pull-up;
			output-low;
		};
	};
};

&qupv3_se0_spi {
	status = "ok";
	// Bump up priority to get better latency
	qcom,rt;
	// this is 3 cycles at 17MHz which is ~180ns
	qcom,set-inter-words-delay = <3>;
	// Set transfer timeout offset to 1000ms
	qcom,xfer-timeout-offset = <1000>;
	spi_stp: spi-stp@0 {
		status = "ok";
		compatible = "meta,spi-stp";
		reg = <0>;
		spi-max-frequency = <17000000>;
		spi-cpha;
		pinctrl-names = "default";
		pinctrl-0 = <&stp_mcu_request_transaction &stp_soc_has_data>;
		mcu-request-transaction = <&tlmm 18 0>;
		soc-has-data = <&tlmm 19 0>;
		channel@0 {
			channel = <STP_CHANNEL_SERVER_LOOPBACK_TEST>;
			tx_buffer_size = <4096>;
			rx_buffer_size = <4096>;
			priority = <STP_CHANNEL_SERVER_LOOPBACK_TEST_PRIORITY>;
		};
		channel@1 {
			channel = <STP_CHANNEL_SERVER_STRESS_TEST>;
			tx_buffer_size = <4096>;
			rx_buffer_size = <4096>;
			priority = <STP_CHANNEL_SERVER_STRESS_TEST_PRIORITY>;
		};
		channel@2 {
			channel = <STP_CHANNEL_CLIENT_LOOPBACK_TEST>;
			tx_buffer_size = <4096>;
			rx_buffer_size = <4096>;
			priority = <STP_CHANNEL_CLIENT_LOOPBACK_TEST_PRIORITY>;
		};
		channel@3 {
			channel = <STP_CHANNEL_CLIENT_STRESS_TEST>;
			tx_buffer_size = <4096>;
			rx_buffer_size = <4096>;
			priority = <STP_CHANNEL_CLIENT_STRESS_TEST_PRIORITY>;
		};
		channel@4 {
			channel = <STP_CHANNEL_DATAX_CLIENT_LOOPBACK_TEST1>;
			tx_buffer_size = <4096>;
			rx_buffer_size = <4096>;
			priority = <STP_CHANNEL_DATAX_CLIENT_LOOPBACK_TEST1_PRIORITY>;
		};
		channel@5 {
			channel = <STP_CHANNEL_STP_RAW_HANLDER_STRESS>;
			tx_buffer_size = <4096>;
			rx_buffer_size = <4096>;
			priority = <STP_CHANNEL_STP_RAW_HANLDER_STRESS_PRIORITY>;
		};
		channel@6 {
			channel = <STP_CHANNEL_DATAX_SERVER_LOOPBACK_TEST1>;
			tx_buffer_size = <4096>;
			rx_buffer_size = <4096>;
			priority = <STP_CHANNEL_DATAX_SERVER_LOOPBACK_TEST1_PRIORITY>;
		};
		channel@7 {
			channel = <STP_CHANNEL_AUDIO_BLOB_TRANSFER>;
			tx_buffer_size = <4096>;
			rx_buffer_size = <4096>;
			priority = <STP_CHANNEL_AUDIO_BLOB_TRANSFER_PRIORITY>;
		};
		channel@8 {
			channel = <STP_CHANNEL_MFG_SENSOR_STREAM_DATA>;
			tx_buffer_size = <4096>;
			rx_buffer_size = <4096>;
			priority = <STP_CHANNEL_MFG_SENSOR_STREAM_DATA_PRIORITY>;
		};
		channel@9 {
