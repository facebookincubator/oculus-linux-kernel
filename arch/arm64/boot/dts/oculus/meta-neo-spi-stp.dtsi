			priority = <STP_CHANNEL_SYSTEM_USER_INPUT_PRIORITY>;
		};
		channel@29 {
			channel = <STP_CHANNEL_LED>;
			tx_buffer_size = <4096>;
			rx_buffer_size = <4096>;
			priority = <STP_CHANNEL_LED_PRIORITY>;
		};
		channel@30 {
			channel = <STP_CHANNEL_MFG>;
			tx_buffer_size = <8192>;
			rx_buffer_size = <8192>;
			priority = <STP_CHANNEL_MFG_PRIORITY>;
		};
		channel@31 {
			channel = <STP_CHANNEL_THROUGHPUT_FULLDUPLEX_TEST>;
			tx_buffer_size = <8192>;
			rx_buffer_size = <8192>;
			priority = <STP_CHANNEL_THROUGHPUT_FULLDUPLEX_TEST_PRIORITY>;
		};
	};
};
